# Copy to backend/.env (git-ignored). Server-side only — never use VITE_ variables for these.
SERV_API_KEY=
SERV_MODEL=gpt-5.4-mini
REPPO_API_KEY=
# Optional
# EVI_DATA_DIR=../data/runs
# EVI_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# EVI_SESSION_JOBS_PER_HOUR=12
# EVI_GLOBAL_SERV_CALLS_PER_DAY=40
# EVI_GLOBAL_REPPO_EVALS_PER_DAY=10
# EVI_MAX_REVISIONS_PER_RUN=2
# EVI_MAX_EVALUATIONS_PER_RUN=2

# Spending allowance (owner-approved; no allowance = no paid work). Empty END = no time limit.
# EVI_ALLOWANCE_ID=public-YYYY-MM-DD
# EVI_ALLOWANCE_START=2026-11-16T08:00:00Z
# EVI_ALLOWANCE_END=
# EVI_ALLOWANCE_SERV_CALLS=21
# EVI_ALLOWANCE_REPPO_EVALS=7

# Judge PDF upload limits (non-secret). Uploads share the allowance above; upload itself calls no provider.
# EVI_UPLOAD_MAX_BYTES=10485760
# EVI_UPLOAD_MAX_PAGES=250
# EVI_UPLOAD_RETENTION_HOURS=24
# EVI_UPLOAD_PER_SESSION_ACTIVE=3
# EVI_UPLOAD_PER_SESSION_PER_HOUR=5
# EVI_UPLOAD_GLOBAL_FILES=100
# EVI_UPLOAD_GLOBAL_BYTES=524288000
