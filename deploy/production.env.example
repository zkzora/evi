# Server-side only. Copy to deploy/production.env on the host (never commit it, never bake it into an image).
# Leave keys blank until a provider budget is explicitly approved.
SERV_API_KEY=
SERV_MODEL=gpt-5.4-mini
REPPO_API_KEY=
# OFF by default: existing results are browsable; new processing and provider calls are refused.
EVI_EXECUTION_ENABLED=false
# Must list the public origin, e.g. https://evi.example.org
EVI_ALLOWED_ORIGINS=
EVI_SESSION_JOBS_PER_HOUR=6
EVI_GLOBAL_SERV_CALLS_PER_DAY=20
EVI_GLOBAL_REPPO_EVALS_PER_DAY=4
EVI_MAX_REVISIONS_PER_RUN=1
EVI_MAX_EVALUATIONS_PER_RUN=1
EVI_WORKER_LEASE_S=300
# Concurrency and Reppo packet (2026-11-16)
EVI_MAX_ACTIVE_JOBS=1
EVI_REPPO_PACKET=reppo-packet-v2
