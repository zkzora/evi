# Reverse proxy: HTTPS + same-origin routing. The API also serves the built SPA with deep-link fallback.
{$EVI_DOMAIN} {
  encode gzip
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "same-origin"
    X-Frame-Options "DENY"
  }
  # Only the PDF upload route accepts a large body (the API enforces 10 MiB itself); everything else stays at 64 KB.
  @upload path /api/v1/uploads
  handle @upload {
    request_body { max_size 11MB }
    reverse_proxy {$EVI_UPSTREAM:api:8000}
  }
  handle {
    request_body { max_size 64KB }
    reverse_proxy {$EVI_UPSTREAM:api:8000}
  }
}
